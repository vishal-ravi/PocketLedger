DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_finance?schema=public"

# --- auth (required) ---------------------------------------------------------
# 32+ random bytes, hex or base64 — signs the session cookie (lib/auth.ts).
# Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Cookies are Secure by default when NODE_ENV=production.
# Set to 1 to force Secure over HTTPS, 0 to disable (local prod testing only).
# COOKIE_SECURE=1

# --- app ---------------------------------------------------------------------
# Public origin used in verification/reset emails (lib/urls.ts)
APP_URL="https://yourdomain.example"

# --- email -------------------------------------------------------------------
# mailer.ts transports:
#   smtp     → real SMTP via nodemailer   (needs SMTP_URL)
#   webhook  → POST JSON to MAIL_WEBHOOK_URL (Resend/SendGrid/Postmark relay)
#   file     → default; appends to logs/mail/outbox.log and logs the link
# MAIL_TRANSPORT=file
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# MAIL_WEBHOOK_URL="https://api.resend.com/emails"
# MAIL_WEBHOOK_KEY="re_..."
# MAIL_FROM="PocketLedger <no-reply@yourdomain.example>"

# --- ops ---------------------------------------------------------------------
# debug | info | warn | error (structured JSON lines on stdout)
# LOG_LEVEL=info
# Refuse to run prisma/seed*.ts in production unless ALLOW_SEED=1
# ALLOW_SEED=0

# --- docker compose -----------------------------------------------------------
# DB password used inside the compose network (db port is not published)
# POSTGRES_PASSWORD=change-me
# Host port for the app container (default 3000)
# APP_PORT=3000
